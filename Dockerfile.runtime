# 런타임 전용 이미지 — <이미 빌드된> build/ 를 담기만 한다. 여기서는 빌드하지 않는다.
#
# 빌드는 Jenkins 에서 끝내고 산출물을 Nexus 에 올린 뒤, 배포 서버는 그것을 받아 이 이미지를 조립한다.
# 이 전환의 직접적인 이유가 admin-frontend 다 — 배포 디렉터리가 SCP 누적이라 저장소에서
# 지운 화면 계열(e488367, dead screen families)이 서버에 남아 계속 빌드에 섞여 들어갔고,
# 그 유령 화면이 참조하던 컴포넌트를 정리하려다 빌드 실패·서비스 중단까지 갔다(#21).
# Jenkins 가 git 체크아웃만으로 빌드하면 그 잔재는 구조적으로 들어올 수 없다.
#
# Dockerfile.build(2단계 빌드)는 로컬 개발·비상시 서버 빌드를 위해 남겨 둔다.
FROM nginx:alpine

ENV TZ=Asia/Seoul
RUN apk add --no-cache tzdata openssl && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo "$TZ" > /etc/timezone

RUN rm -f /etc/nginx/conf.d/default.conf

# 런타임에 envsubst 로 BACKEND_* 만 치환한다(기존과 동일).
COPY nginx.conf /etc/nginx/nginx.conf.template

# Jenkins 가 만든 산출물. vite build 의 outDir 이 build/ 다(dist 아님).
COPY build /usr/share/nginx/html

RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/server.key \
    -out /etc/nginx/ssl/server.crt \
    -subj "/C=KR/ST=Seoul/L=Seoul/O=AICC/OU=IT/CN=localhost"

EXPOSE 80
EXPOSE 443

# 산출물이 실제로 들어갔는지 조립 시점에 확인한다 — 빈 이미지가 배포되는 것을 막는다.
RUN test -f /usr/share/nginx/html/index.html

CMD ["/bin/sh", "-c", "envsubst '${BACKEND_HOST} ${BACKEND_PORT} ${BACKEND_API_URL}' < /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
