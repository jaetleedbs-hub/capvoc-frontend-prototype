# 프론트엔드 로컬 환경변수 템플릿
#
#   사용법:  cp .env.example .env
#
# .env 는 .gitignore 대상이다. 값이 없으면 vite.config.js 의 기본값으로 뜬다.

# 개발 서버 포트
VITE_PORT=18031

# /api · /login · /logout 을 프록시할 백엔드 주소.
#  ★ backend/.env 의 SERVER_PORT 와 <반드시 짝이 맞아야> 한다.
#    여기를 백엔드와 같은 포트로 주면 vite 가 자기 자신을 가리켜 500 이 된다.
VITE_PROXY_TARGET=http://localhost:18030

# 테마·회사별 빌드 스위치(src/common/theme.js). 비우면 DEFAULT
# VITE_COMPANY_CODE=DEFAULT
