# Node.js를 사용하여 React 애플리케이션 빌드 (빌드 스테이지)
# Vite 6 은 Node 18+ 를 요구한다. node:16 에서는 vite createBuilder 가 크래시해
# build/ 산출물이 만들어지지 않는다(EBADENGINE: required node >=18).
FROM node:20 AS build

# 작업 디렉토리 설정
WORKDIR /app

# package.json과 .npmrc 복사
COPY package.json ./
COPY .npmrc ./

# 의존성 설치
RUN echo "=== Installing dependencies ===" && \
    npm install --legacy-peer-deps && \
    echo "=== Dependencies installed successfully ===" && \
    echo "node_modules size: $(du -sh node_modules 2>/dev/null || echo 'N/A')"

# 소스 코드 복사
COPY . .

# 복사된 파일 확인
RUN echo "=== Verifying source files ===" && \
    ls -la src/containers/ | head -20 && \
    test -f src/containers/App.js && echo "✓ App.js found" || echo "✗ App.js NOT FOUND"

# React 애플리케이션 빌드
RUN echo "=== Starting React build ===" && \
    echo "Node: $(node --version)" && \
    echo "NPM: $(npm --version)" && \
    NODE_OPTIONS="--max-old-space-size=4096" npm run build 2>&1 | tee /tmp/build.log || { \
        echo "=== BUILD FAILED! Last 50 lines of output: ==="; \
        tail -50 /tmp/build.log; \
        exit 1; \
    } && \
    echo "=== Build completed ===" && \
    ls -lh build/ | head -10

# Nginx를 사용하여 정적 파일 서비스 (런타임 스테이지)
FROM nginx:alpine

# Timezone 설정
ENV TZ=Asia/Seoul
RUN apk add --no-cache tzdata openssl && \
    cp /usr/share/zoneinfo/$TZ /etc/localtime && \
    echo "$TZ" > /etc/timezone

# Nginx 기본 설정 파일 삭제
RUN rm /etc/nginx/conf.d/default.conf

# nginx.conf를 template으로 복사 (런타임에 envsubst로 BACKEND_HOST, BACKEND_PORT만 치환)
COPY nginx.conf /etc/nginx/nginx.conf.template

# 빌드 스테이지에서 생성된 React 빌드 결과물 복사
COPY --from=build /app/build /usr/share/nginx/html

# Create SSL directory and generate self-signed certificate
RUN mkdir -p /etc/nginx/ssl && \
    openssl req -x509 -nodes -days 365 -newkey rsa:2048 \
    -keyout /etc/nginx/ssl/server.key \
    -out /etc/nginx/ssl/server.crt \
    -subj "/C=KR/ST=Seoul/L=Seoul/O=AICC/OU=IT/CN=localhost"

# Nginx 포트 노출
EXPOSE 80
EXPOSE 443

# 컨테이너 시작 시 envsubst로 BACKEND_HOST/BACKEND_PORT만 치환 후 Nginx 실행
CMD ["/bin/sh", "-c", "envsubst '${BACKEND_HOST} ${BACKEND_PORT} ${BACKEND_API_URL}' < /etc/nginx/nginx.conf.template > /etc/nginx/conf.d/default.conf && nginx -g 'daemon off;'"]
